@startuml

actor HR as "HR Advisor"

rectangle Database

rectangle "HR System" {
    usecase UC1 as "Get salaries
    of all employees"

    usecase UCa as "Print salaries"

    HR - UC1
    UC1 ..> UCa : include
    UC1 - Database
}

@enduml

